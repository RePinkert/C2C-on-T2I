, creating an unsettling silence."}}, "11": {"class_type": "KSampler", "inputs": {"model": ["2", 0], "negative": ["7", 0], "latent_image": ["8", 0], "seed": 1042, "steps": 25, "cfg": 3.0, "sampler_name": "er_sde", "scheduler": "simple", "denoise": 1.0, "positive": ["4", 0]}}, "14": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["10", 0]}}, "17": {"class_type": "SaveImage", "inputs": {"images": ["14", 0], "filename_prefix": "exp_v2/A_moss_p13_s1042/raw"}}, "20": {"class_type": "AddLabel", "inputs": {"image": ["14", 0], "text_x": 10, "text_y": 2, "height": 64, "font_size": 40, "font_color": "white", "label_color": "black", "font": "FreeMonoBoldOblique.otf", "text": "RAW", "direction": "up"}}, "12": {"class_type": "KSampler", "inputs": {"model": ["2", 0], "negative": ["7", 0], "latent_image": ["8", 0], "seed": 1042, "steps": 25, "cfg": 3.0, "sampler_name": "er_sde", "scheduler": "simple", "denoise": 1.0, "positive": ["5", 0]}}, "15": {"class_type": "VAEDecode", "inputs": {"samples": ["12", 0], "vae": ["10", 0]}}, "18": {"class_type": "SaveImage", "inputs": {"images": ["15", 0], "filename_prefix": "exp_v2/A_moss_p13_s1042/t2t"}}, "21": {"class_type": "AddLabel", "inputs": {"image": ["15", 0], "text_x": 10, "text_y": 2, "height": 64, "font_size": 40, "font_color": "white", "label_color": "black", "font": "FreeMonoBoldOblique.otf", "text": "T2T", "direction": "up"}}, "13": {"class_type": "KSampler", "inputs": {"model": ["2", 0], "negative": ["7", 0], "latent_image": ["8", 0], "seed": 1042, "steps": 25, "cfg": 3.0, "sampler_name": "er_sde", "scheduler": "simple", "denoise": 1.0, "positive": ["6", 0]}}, "16": {"class_type": "VAEDecode", "inputs": {"samples": ["13", 0], "vae": ["10", 0]}}, "19": {"class_type": "SaveImage", "inputs": {"images": ["16", 0], "filename_prefix": "exp_v2/A_moss_p13_s1042/c2c"}}, "22": {"class_type": "AddLabel", "inputs": {"image": ["16", 0], "text_x": 10, "text_y": 2, "height": 64, "font_size": 40, "font_color": "white", "labe